# 复制为 .env 后按需修改

# PostgreSQL
POSTGRES_PASSWORD=telebook

# MinIO（M4 使用）
MINIO_ROOT_USER=telebook
MINIO_ROOT_PASSWORD=telebook123456

# 连接密钥：客户端注册设备时提交（高熵随机串）
SYNC_SECRET=change-me-connect-key

# JWT 签名密钥
JWT_SECRET=change-me-jwt-secret

# 手机/客户端可达的 MinIO 地址（host:port），预签名下载用它；容器内默认 minio:9000 手机无法访问
MINIO_PUBLIC_ENDPOINT=192.168.31.202:19000
